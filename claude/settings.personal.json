{
  "model": "opus[1m]",
  "theme": "auto",
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(rg:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh api * -X DELETE:*)",
      "Bash(gh api * -X PUT:*)",
      "Bash(gh api * -X PATCH:*)",
      "Bash(gh api * -X POST:*)",
      "Bash(gh api * --method DELETE:*)",
      "Bash(gh api * --method PUT:*)",
      "Bash(gh api * --method PATCH:*)",
      "Bash(gh api * --method POST:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(* --force *)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)"
    ]
  }
}
